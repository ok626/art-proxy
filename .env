# Your TMDB API key — get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Port to run the server on (default: 3000)
PORT=3000

# TMDB image sizes
# Poster options:  w92, w154, w185, w342, w500, w780, original
# Backdrop options: w300, w780, w1280, original
POSTER_SIZE=w780
BACKDROP_SIZE=w1280

# How long to cache the selected image per title, in seconds (default: 24 hours)
# This means the same title returns the same art for this duration
SELECTION_CACHE_TTL=86400

# How long to cache raw TMDB API responses, in seconds (default: 1 hour)
TMDB_CACHE_TTL=3600
