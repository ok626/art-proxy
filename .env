# TMDB API key — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Fanart.tv API key — https://fanart.tv/get-an-api-key/
FANART_API_KEY=your_fanart_api_key_here

# Port
PORT=3000

# TMDB image sizes (used only for TMDB fallback)
# Poster options:   w92, w154, w185, w342, w500, w780, original
# Backdrop options: w300, w780, w1280, original
POSTER_SIZE=w780
BACKDROP_SIZE=w1280

# Minimum likes on Fanart for an image to be considered (default: 5)
FANART_MIN_LIKES=5

# Cache TTLs in seconds
SELECTION_CACHE_TTL=86400   # 24h — how long the chosen art is locked in per title
TMDB_CACHE_TTL=3600         # 1h  — raw TMDB API response cache
FANART_CACHE_TTL=3600       # 1h  — raw Fanart API response cache

# Minimum Fanart pool size before TMDB is pulled in to supplement (default: 8)
FANART_MIN_POOL_SIZE=8
