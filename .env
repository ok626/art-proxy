# ── API Keys ──────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
FANART_API_KEY=your_fanart_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Image Sizes ───────────────────────────────────────────────────────────────
# Poster options:   w92, w154, w185, w342, w500, w780, original
# Backdrop options: w300, w780, w1280, original
POSTER_SIZE=w780
BACKDROP_SIZE=original

# ── Fanart Quality ────────────────────────────────────────────────────────────
FANART_MIN_LIKES=0
FANART_MIN_POOL_SIZE=8

# ── Mode Flags ────────────────────────────────────────────────────────────────
# TMDB_ONLY: skip Fanart entirely, use TMDB as sole source
# true | false (default: false)
TMDB_ONLY=false

# TMDB_TRUST: trust TMDB's own ordering instead of our scoring system
# Takes top N results by TMDB order (language/textless filtered) with resolution check
# true | false (default: false)
TMDB_TRUST=false

# How many results to take in trust mode (default: 6)
TMDB_TRUST_POOL_SIZE=6

# ── Cache TTLs (in seconds) ───────────────────────────────────────────────────
TMDB_CACHE_TTL=3600
FANART_CACHE_TTL=3600
POOL_CACHE_TTL=604800
POSTER_SELECTION_TTL=604800
BACKDROP_SELECTION_TTL=43200
