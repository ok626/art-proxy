# ── API Keys ──────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
FANART_API_KEY=your_fanart_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Image Sizes ───────────────────────────────────────────────────────────────
# Poster options:   w92, w154, w185, w342, w500, w780, original
# Backdrop options: w300, w780, w1280, original
POSTER_SIZE=w780
BACKDROP_SIZE=original

# ── Fanart Quality ────────────────────────────────────────────────────────────
# Minimum likes for Fanart art to be preferred in pool ordering (0 = include all)
FANART_MIN_LIKES=0
# Minimum Fanart pool size before TMDB is pulled in to supplement
FANART_MIN_POOL_SIZE=8

# ── Cache TTLs (in seconds) ───────────────────────────────────────────────────
# Raw API responses from TMDB and Fanart
TMDB_CACHE_TTL=3600
FANART_CACHE_TTL=3600

# Combined candidate pool per title (how long before pool is rebuilt from APIs)
# 86400 = 24h, 259200 = 3 days, 604800 = 7 days
POOL_CACHE_TTL=259200

# How long the chosen poster is locked in per title
# 0 = always pick fresh random from pool on every request
POSTER_SELECTION_TTL=86400

# How long the chosen backdrop is locked in per title
# 0 = always pick fresh random from pool on every request (recommended for backdrops)
# 259200 = 3 days if you want stability
BACKDROP_SELECTION_TTL=259200
